# Single-tenant credentials (stdio, and HTTP only when AUTH_MODE=env).
# The gateway-mode compose service does not load these. Do not add them to
# that service's environment or via env_file.
# ikey identifies the integration; skey is the HMAC-SHA512 signing secret and
# is bearer-equivalent for this integration's admin scope. apiHost is this
# account's Duo API hostname (e.g. api-xxxxxxxx.duosecurity.com).
DUO_IKEY=
DUO_SKEY=
DUO_API_HOST=

# stdio (default) or http
MCP_TRANSPORT=stdio

# env:     DUO_* above, after X-Gateway-S2S verifies (HTTP) or directly (stdio).
# gateway: X-Duo-Ikey, X-Duo-Skey, and X-Duo-Api-Host on each /mcp request.
#          Never falls back to DUO_*. Docker image and Compose default.
# AUTH_MODE=env

# Required to start the HTTP transport. Leave this empty. The process exits
# if it is empty or a known placeholder (changeme, placeholder, your-s2s-secret,
# replace-me, unresolved ${...} templates, and similar). Compose will not
# start when it is unset. Never commit a real value.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without a usable
# CONDUIT_S2S_SECRET. Logs a warning, does not enforce X-Gateway-S2S, and
# listens on 127.0.0.1 only (a wider MCP_HTTP_HOST is ignored).
# MCP_ALLOW_INSECURE_DEV=1

# Bind address. Honored only when CONDUIT_S2S_SECRET is a real secret.
# Unset with a secret keeps the historical default 0.0.0.0. The container
# image sets 0.0.0.0. Without a usable secret the listener is 127.0.0.1.
# MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080

# Transport security (CWE-319). A non-loopback bind refuses to start unless
# one of these is set. Loopback binds are always allowed.
# PEM certificate path; with MCP_TLS_KEY_FILE serves HTTPS in-process.
# MCP_TLS_CERT_FILE=
# PEM private key path; must be set together with MCP_TLS_CERT_FILE.
# MCP_TLS_KEY_FILE=
# Set to exactly 1 when TLS terminates at a trusted ingress; serves plain HTTP and logs a warning.
# MCP_TRUSTED_TLS_INGRESS=1

LOG_LEVEL=info
